# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Your Discord server ID — enables instant slash command sync during startup
# Right-click your server icon → Copy Server ID (requires Developer Mode)
GUILD_ID=your_discord_guild_id_here

# Comma-separated Discord role IDs that are allowed to use bot commands
# Right-click a role → Copy Role ID (requires Developer Mode)
ADMIN_ROLE_IDS=123456789012345678,987654321098765432

# Channel ID where /schedule tasks post their output
# Right-click a channel → Copy Channel ID (requires Developer Mode)
SCHEDULE_CHANNEL_ID=your_channel_id_here

# Valheim server RCON connection details
# RCON_PORT defaults to server_port + 2 (e.g. if game port is 2456, RCON is 2458)
RCON_HOST=your.server.ip.or.hostname
RCON_PORT=2458
RCON_PASSWORD=your_rcon_password_here
